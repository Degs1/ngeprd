# 9router local proxy configuration
AI_BASE_URL=http://127.0.0.1:20128/v1
AI_API_KEY=your_api_key_here
AI_MODEL=ag/gemini-3.8-flash-high
AI_TIMEOUT_MS=45000

# AI Concurrency & RPM Limiter Configuration
AI_MAX_CONCURRENCY=4
AI_MAX_RPM=60
AI_MAX_RATE_LIMIT_RETRIES=3

# MongoDB Configuration
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=bikinprd

# Auth.js / Google OAuth Configuration
AUTH_SECRET=your_authjs_secret_minimum_32_characters
AUTH_GOOGLE_ID=your_google_client_id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your_google_client_secret

# Admin privileges (comma-separated email list, bypasses daily PRD limit)
ADMIN_EMAILS=admin@example.com

# Daily PRD limit for free users (default: 3)
DAILY_PRD_LIMIT=3
