# Durable worker submissions (pause with false during rollout or rollback)
AI_JOB_SUBMISSIONS_ENABLED=true
AI_PROVIDER_HOST_ALLOWLIST=api.openai.com,provider.example.com
AI_CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
AI_MAX_ACTIVE_JOBS_PER_USER=1

# MongoDB Configuration
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=bikinprd

# Auth.js / Google OAuth Configuration
AUTH_SECRET=your_authjs_secret_minimum_32_characters
AUTH_GOOGLE_ID=your_google_client_id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your_google_client_secret

# Admin privileges (comma-separated email list, bypasses daily PRD limit)
ADMIN_EMAILS=admin@example.com

# Daily PRD limit for free users (default: 3)
DAILY_PRD_LIMIT=3
